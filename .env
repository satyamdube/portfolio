# Vector Database Configuration
# Supported Providers: inmemory | pinecone | supabase | qdrant | custom
VITE_VECTOR_DB_PROVIDER=inmemory
VITE_VECTOR_DB_URL=https://api.vectordb.example.com/v1
VITE_VECTOR_DB_API_KEY=vdb_sec_demo_9847129841289471928471928
VITE_VECTOR_DB_COLLECTION=satyam_portfolio_embeddings
