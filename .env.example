# ==============================================================================
# SATYAM DUBEY PORTFOLIO - VECTOR DB & RAG CONFIGURATION (EXAMPLE)
# Copy this file to .env and set your Vector DB credentials
# ==============================================================================

# Vector Database Configuration
# Supported Providers: inmemory | pinecone | supabase | qdrant | custom
VITE_VECTOR_DB_PROVIDER=inmemory
VITE_VECTOR_DB_URL=https://api.vectordb.example.com/v1
VITE_VECTOR_DB_API_KEY=your_vector_db_api_key_here
VITE_VECTOR_DB_COLLECTION=satyam_portfolio_embeddings
VITE_VECTOR_DB_TOP_K=3

# LLM Inference Provider (Optional: leave blank to use Built-in RAG Brain)
# Supported Providers: builtin | groq | openai | gemini
VITE_LLM_PROVIDER=builtin
VITE_LLM_MODEL=llama-3.3-70b-versatile
VITE_LLM_API_KEY=

# Embedding Model
VITE_EMBEDDING_MODEL=text-embedding-3-small
