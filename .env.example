# Legacy / Alternative Vector DB Provider
# Supported: inmemory | upstash | pinecone | supabase | qdrant
VITE_VECTOR_DB_PROVIDER=upstash
VITE_VECTOR_DB_URL=
VITE_VECTOR_DB_API_KEY=
VITE_VECTOR_DB_COLLECTION=satyam_portfolio_embeddings
VITE_VECTOR_DB_TOP_K=3

# Optional Cloud LLM (Leave empty to use built-in neural RAG synthesizer)
# Supported: builtin | groq | openai
