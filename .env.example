# Upstash Cloud Vector Database (Recommended - Free Tier: 10,000 queries/day)
# 1. Sign up at https://console.upstash.com (1-click GitHub login)
# 2. Click "Create Index" -> choose a name (e.g. "satyam-portfolio")
# 3. Choose distance metric: "Cosine" and model: "BAAI/bge-small-en-v1.5" (or any default)
# 4. Copy the UPSTASH_VECTOR_REST_URL and UPSTASH_VECTOR_REST_TOKEN from the dashboard
UPSTASH_VECTOR_REST_URL=https://united-boa-95622-us1-vector.upstash.io
